# --------------------------------------------------------------------------
# THIS FILE IS AUTOGENERATED - DO NOT EDIT MANUALLY
#
# Source: Containerfile.pkg.j2
# --------------------------------------------------------------------------

ARG BASE_VERSION=15.1
FROM ghcr.io/daemonless/base-exec:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG PKG_NAME="couchdb3"
ARG PACKAGES="${PKG_NAME} ca_root_nss"
ARG HEALTHCHECK_ENDPOINT="http://127.0.0.1:5984/_up"

ENV HEALTHCHECK_URL="${HEALTHCHECK_ENDPOINT}"

LABEL org.opencontainers.image.title="CouchDB" \
      org.opencontainers.image.description="Seamless multi-primary syncing JSON document database with an HTTP API, MapReduce views, and Couch Replication Protocol support." \
      org.opencontainers.image.source="https://github.com/daemonless/couchdb" \
      org.opencontainers.image.url="https://couchdb.apache.org/" \
      org.opencontainers.image.documentation="https://docs.couchdb.org/" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="Databases" \
      io.daemonless.port="5984" \
      io.daemonless.volumes="/config" \
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.pkg-source="pkg" \
      io.daemonless.packages="${PACKAGES}" \
      io.daemonless.pkg-name="${PKG_NAME}" \
      io.daemonless.healthcheck-url="${HEALTHCHECK_ENDPOINT}"

# Install Apache CouchDB from FreeBSD packages
RUN pkg update && \
    pkg install -y ${PACKAGES} && \
    mkdir -p /app /config/data /config/etc/local.d \
             /usr/local/libexec/couchdb3/etc/default.d && \
    pkg query '%v' ${PKG_NAME} > /app/version && \
    ln -sf /usr/local/libexec/couchdb3/bin/couchdb /usr/local/bin/couchdb && \
    ln -sf /usr/local/libexec/couchdb3/bin/remsh /usr/local/bin/remsh && \
    ln -sf /usr/local/libexec/couchdb3/bin/weatherreport /usr/local/bin/weatherreport && \
    chmod -R a+rX /usr/local/etc/couchdb3 && \
    chown -R bsd:bsd /config && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

COPY root/ /
RUN chmod +x /daemonless/libexec/couchdb

WORKDIR /config
CMD ["/daemonless/libexec/couchdb"]

# 5984: HTTP API and Fauxton UI; 4369: epmd; 9100: Erlang cluster distribution
EXPOSE 5984 4369 9100
VOLUME /config